{
	"name": "n8n-nodes-lightsprint",
	"version": "0.1.1",
	"description": "n8n community node for Lightsprint — manage tasks, comments, and AI agents",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/SprintsAI/n8n-nodes-lightsprint"
	},
	"keywords": ["n8n-community-node-package"],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/LightsprintOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/Lightsprint/Lightsprint.node.js"
		]
	},
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": ["dist"],
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"typescript": "~5.9.3"
	},
	"overrides": {
		"axios": "1.18.1",
		"form-data": "4.0.6",
		"handlebars": "4.7.9",
		"langsmith": "0.6.0",
		"lodash": "4.18.1",
		"minimatch": "9.0.7",
		"js-yaml": "5.2.0",
		"uuid": "13.0.1",
		"follow-redirects": "1.16.0",
		"tmp": "0.2.7",
		"@langchain/community": "1.1.28",
		"undici": "6.27.0",
		"ws": "8.21.0"
	}
}
